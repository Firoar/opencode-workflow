# Four-model profile — benchmark-backed mapping.
#
# Only these four models are allowed:
#   opencode-go/glm-5.3-flash
#   opencode-go/deepseek-v4.1-flash
#   opencode-go/muse-spark-1.3-contributor
#   opencode-go/mimo-v2.6-flash
#
# MiMo V2.6 is deliberately not used: Vals AI found it searches for leaked
# reference fixes in Git history/upstream instead of solving coding tasks.
# If you still want it, set MODEL_EXPLORER=opencode-go/mimo-v2.6-flash.

MODEL_GRILL=opencode-go/muse-spark-1.3-contributor#xhigh
MODEL_SPEC=opencode-go/muse-spark-1.3-contributor#xhigh
MODEL_TICKETS=opencode-go/glm-5.3-flash#max
MODEL_IMPLEMENT=opencode-go/glm-5.3-flash#max
MODEL_IMPLEMENTER=opencode-go/deepseek-v4.1-flash#max
MODEL_REVIEW=opencode-go/glm-5.3-flash#max
MODEL_REVIEW_STANDARDS=opencode-go/glm-5.3-flash#max
MODEL_REVIEW_SPEC=opencode-go/muse-spark-1.3-contributor#xhigh
MODEL_EXPLORER=opencode-go/glm-5.3-flash#max
MODEL_MERGER=opencode-go/glm-5.3-flash#max
MODEL_SETUP=opencode-go/glm-5.3-flash#max
MODEL_HANDOFF=opencode-go/muse-spark-1.3-contributor#xhigh
